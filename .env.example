# Local foundation. Change to claude after adding your own key locally.
AGENT_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
CLINIC_TIMEZONE=America/Los_Angeles
AGENT_DATA_DIR=./data

# Optional cloud traces. Local traces are always recorded.
# Enable only with synthetic / appropriately de-identified inputs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clinic-voice-agent-dev

# Hosted Deepgram STT + TTS; English calls. No Voice Agent API or region needed.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
SPEECH_LANGUAGE=en
SPEECH_ENDPOINTING_MS=650

# Optional: custom JSON evidence corpus; default is bundled fictional demo rules.
# INSURANCE_KB_PATH=./voice_agent/knowledge/insurance-demo.json

# Required only for a Claude key not scoped to a single workspace.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Supervisor + independent ReAct specialists via a local MCP toolkit.
AGENT_ARCHITECTURE=multi-agent
AGENT_MAX_ROUNDS=5

# Independent evaluation model; business agents keep ANTHROPIC_MODEL.
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL=your-available-claude-model
